# Meta WhatsApp Business Cloud API
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WEBHOOK_VERIFY_TOKEN=

# Supabase Database
SUPABASE_URL=your_supabase_url_here
SUPABASE_KEY=your_supabase_anon_key_here
# Postgres connection string (tables are created and the admin below is seeded on startup)
DATABASE_URL=

# Dashboard administrator (seeded on startup when DATABASE_URL is set)
ADMIN_EMAIL=admin@limkobot.local
ADMIN_PASSWORD=change-me-8-chars-min
ADMIN_PHONE=+23225000000
ADMIN_NAME=LimkoBot Administrator

# OpenAI API (for RAG)
OPENAI_API_KEY=your_openai_api_key_here

# JWT Secret
JWT_SECRET_KEY=your_secret_key_here
JWT_ALGORITHM=HS256

# Email (for OTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password

# Frontend URL (for admin dashboard)
FRONTEND_URL=http://localhost:3000

# Backend URL
BACKEND_URL=http://localhost:8000